{
  "name": "netizen-image-viewer",
  "version": "0.1.0",
  "description": "A minimal Linux image viewer built with Electron.",
  "desktopName": "netizen-image-viewer",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "engines": {
    "node": "24.21.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "package": "npm run build && electron-builder --linux AppImage",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --check \"**/*.{css,html,json,ts}\"",
    "format:write": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test"
  },
  "dependencies": {
    "exifr": "^7.1.3",
    "lucide": "^1.47.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.53.1",
    "@types/node": "^22.15.29",
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^3.1.0",
    "eslint": "^9.30.1",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.36.0",
    "vitest": "^3.2.4"
  },
  "build": {
    "appId": "io.netizen.image",
    "productName": "Netizen-Image-Viewer",
    "files": [
      "out/**",
      "package.json"
    ],
    "linux": {
      "syncDesktopName": true,
      "target": [
        "AppImage"
      ],
      "category": "Graphics",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    }
  }
}
